# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# Terraform plan output files
*.tfplan
*.plan

# CLI configuration files
.terraformrc
terraform.rc

# Ignore local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore lock info generated during terraform runs
.terraform.tfstate.lock.info
